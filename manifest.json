{
  "manifest_version": 3,
  "name": "Bloqueador",
  "version": "0.3.0",
  "description": "Bloqueador de anuncios personal para Twitter/X, YouTube, Twitch y webs en general.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "downloads"],
  "background": {
    "service_worker": "src/fondo.js"
  },
  "action": {
    "default_title": "Bloqueador",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/sitios/twitter-api.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/comun/ajustes.js", "src/comun/ocultar.js", "src/sitios/twitter.js", "src/sitios/twitter-videos.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/comun/ajustes.js", "src/comun/ocultar.js", "src/sitios/youtube.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.twitch.tv/*"],
      "js": ["src/comun/ajustes.js", "src/comun/ocultar.js", "src/sitios/twitch.js"],
      "run_at": "document_idle"
    }
  ]
}
